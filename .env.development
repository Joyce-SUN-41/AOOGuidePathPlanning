# ============================================================
# 前端开发环境变量 (vite --mode development，即 npm run dev 默认加载)
#
# 说明:
# - 仅以 VITE_ 开头的变量会被注入到客户端代码 (import.meta.env)
# - 切勿在此文件写入任何密钥/凭据，它会被打包进前端产物
# - 本地个性化覆盖请新建 .env.local（已在 .gitignore 中忽略）
# ============================================================

# 应用信息
VITE_APP_TITLE=燕麦智导
VITE_APP_ENV=development

# API 基础路径
# 开发环境走 Vite devServer 代理（见 vite.config.ts 的 server.proxy）
# 保持相对路径 /api/v1，请求会被代理到 VITE_PROXY_TARGET
VITE_API_BASE_URL=/api/v1

# Vite 开发代理目标（后端地址）
# Docker 环境下由容器环境变量覆盖为 http://backend:8000
VITE_PROXY_TARGET=http://localhost:8000

# 调试开关
VITE_DEBUG=true

# 前端埋点上报开关（仅当值为 true 时才真正发送 /analytics/track 请求）
# 本地联调埋点时，可在 .env.local 中覆盖为 true，避免污染开发环境统计数据
VITE_ENABLE_TRACKING=false
