# 复制此文件为 .env 并填入真实配置
# cp .env.example .env

# ==================== 应用配置 ====================
PROJECT_NAME="AOO Guide Path Planning"
PROJECT_DESCRIPTION="AOO算法引导路径规划系统"
VERSION="0.1.0"

APP_HOST=0.0.0.0
APP_PORT=8000

DEBUG=true

# ==================== 安全秘钥 ====================
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== 数据库 ====================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aoo_user
POSTGRES_PASSWORD=aoo_password_2024
POSTGRES_DB=aoo_guide_path

DATABASE_URL=postgresql+asyncpg://aoo_user:aoo_password_2024@localhost:5432/aoo_guide_path

# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ==================== 讯飞星火 ====================
XF_APP_ID=
XF_API_KEY=
XF_API_SECRET=
XF_API_URL=wss://spark-api.xf-yun.com/v3.5/chat
XF_MODEL=spark-x

# ==================== 讯飞星辰 Agent ====================
# 从星辰 Agent 平台发布页获取完整 endpoint，如:
# https://api-agent.xf-yun.com/v1/flow/run
XINGCHEN_AGENT_API_URL=
XINGCHEN_AGENT_API_KEY=
XINGCHEN_AGENT_FLOW_ID=
XINGCHEN_SESSION_TTL=3600

# ==================== RAG 知识库 ====================
RAG_PERSIST_DIR=./data/chroma_db
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_SIMILARITY_THRESHOLD=0.5
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=4000

# ==================== 日志 ====================
LOG_LEVEL=DEBUG
LOG_FORMAT=console
LOG_FILE_PATH=./logs/app.log

# ==================== CORS ====================
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
