# ==================== 应用配置 ====================
PROJECT_NAME="AOO Guide Path Planning"
PROJECT_DESCRIPTION="AOO算法引导路径规划系统"
VERSION="0.1.0"

# ==================== 服务端口 ====================
APP_HOST=0.0.0.0
APP_PORT=8000

# ==================== 调试模式 ====================
DEBUG=false

# ==================== 安全秘钥 (生产环境务必更换!) ====================
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== 数据库 (PostgreSQL) - Docker 服务名 ====================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=aoo_user
POSTGRES_PASSWORD=aoo_password_2024
POSTGRES_DB=aoo_guide_path

# 异步数据库URL - 使用 Docker 服务名
DATABASE_URL=postgresql+asyncpg://aoo_user:aoo_password_2024@postgres:5432/aoo_guide_path

# ==================== Redis - Docker 服务名 ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# Celery使用的Redis broker URL
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ==================== 讯飞星火大模型 (可选) ====================
XF_APP_ID=
XF_API_KEY=
XF_API_SECRET=
XF_API_URL=wss://spark-api.xf-yun.com/v3.5/chat

# ==================== 讯飞星辰 Agent (可选) ====================
XINGCHEN_AGENT_API_URL=
XINGCHEN_AGENT_API_KEY=
XINGCHEN_AGENT_FLOW_ID=
XINGCHEN_SESSION_TTL=3600

# ==================== RAG 知识库 ====================
RAG_PERSIST_DIR=./data/chroma_db
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_SIMILARITY_THRESHOLD=0.5
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=4000

# ==================== 日志 ====================
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_FILE_PATH=./logs/app.log

# ==================== CORS ====================
CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:5173"]
