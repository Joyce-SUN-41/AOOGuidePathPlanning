# ==================== 应用配置 ====================
PROJECT_NAME="AOO Guide Path Planning"
PROJECT_DESCRIPTION="AOO算法引导路径规划系统"
VERSION="0.1.0"

# ==================== 服务端口 ====================
APP_HOST=0.0.0.0
APP_PORT=8000

# ==================== 调试模式 ====================
DEBUG=false

# ==================== 安全秘钥 ====================
# 本地/预发默认值；生产部署请在 docker-compose.prod.yml 用 environment 覆盖
# 生成强随机: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-with-secrets-token-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== 数据库 (PostgreSQL) - Docker 服务名 ====================
# ⚠ 凭据必须与 docker-compose.yml / docker-compose.prod.yml 中 postgres 容器一致
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=aoo_user
POSTGRES_PASSWORD=aoo_password_2024
POSTGRES_DB=aoo_guide_path

# 异步数据库URL - 使用 Docker 服务名
DATABASE_URL=postgresql+asyncpg://aoo_user:aoo_password_2024@postgres:5432/aoo_guide_path

# ==================== Redis - Docker 服务名 ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# Celery使用的Redis broker URL
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ==================== 讯飞星火助手 API ====================
# WebSocket 模式鉴权参数 (控制台 → 星火助手 → 接口鉴权参数)
XF_APP_ID=b9539fed
XF_API_KEY=cf804bcaf28888a0b7a0e46f7178f8bb
XF_API_SECRET=NjdjNjJhMjQ2ODhhNTA0YjliOGRhMzFh
XF_ASSISTANT_ID=
# REST API 认证 (与 WS 的 api_key/api_secret 不同，需从控制台各模型版本页面获取)
XF_API_PASSWORD=SMdMXYFllyNmJPKaMmpW:inTcxPYZhhyIReyyXsVt
# API URL: http(s):// → REST 模式; ws(s):// → WebSocket 模式
# 星火开放平台 Spark X2 专属 REST 端点；model 字段必传 spark-x
XF_API_URL=https://spark-api-open.xf-yun.com/x2/chat/completions
# Spark X2 的 model 固定为 spark-x
XF_MODEL=spark-x

# ==================== 讯飞星辰 Agent (可选) ====================
# 从星辰 Agent 平台发布页获取完整 endpoint
XINGCHEN_AGENT_API_URL=
XINGCHEN_AGENT_API_KEY=
XINGCHEN_AGENT_FLOW_ID=
XINGCHEN_SESSION_TTL=3600

# ==================== RAG 知识库 ====================
RAG_PERSIST_DIR=./data/vector_store
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_SIMILARITY_THRESHOLD=0.5
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=4000

# ==================== 日志 ====================
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_FILE_PATH=./logs/app.log

# ==================== CORS ====================
# 生产环境：替换为你的实际域名，用逗号分隔
# 示例: ["https://your-domain.com","https://www.your-domain.com"]
CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:5173"]
