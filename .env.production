# ============================================================
# 前端生产环境变量 (vite build 默认加载 --mode production)
#
# 说明:
# - 仅以 VITE_ 开头的变量会被注入到客户端代码 (import.meta.env)
# - 这些值会被硬编码进构建产物，切勿写入任何密钥/凭据
# - 生产部署由 Nginx 将 /api/ 反向代理到后端容器（见 nginx.conf）
# ============================================================

# 应用信息
VITE_APP_TITLE=燕麦智导
VITE_APP_ENV=production

# API 基础路径
# 生产环境同域部署，由 Nginx 反代到 backend:8000，保持相对路径即可
VITE_API_BASE_URL=/api/v1

# 关闭调试输出
VITE_DEBUG=false

# 前端埋点上报开关
# 置为 true 后，业务点位（user_login / diagnosis_submit / path_generate_complete /
# chat_query / page_view 等）才会批量上报到 POST /api/v1/analytics/track；
# 为 false 时 tracking 模块完全空转，不注册监听器、不产生任何网络请求。
VITE_ENABLE_TRACKING=false
